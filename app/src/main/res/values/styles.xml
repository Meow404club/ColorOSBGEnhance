<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/item_title</item>
        <item name="android:textColorPrimary">@color/title_text</item>
        <item name="materialCardViewStyle">@style/Widget.ColorOSBgEnhance.Card</item>
    </style>

    <style name="Widget.ColorOSBgEnhance.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="TextAppearance.ColorOSBgEnhance.PageTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/title_text</item>
        <item name="android:textSize">@dimen/page_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ColorOSBgEnhance.SettingTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/item_title</item>
        <item name="android:textSize">@dimen/setting_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ColorOSBgEnhance.Summary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/item_summary</item>
        <item name="android:textSize">@dimen/setting_summary_size</item>
    </style>
</resources>
