<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingEnd="@dimen/screen_horizontal">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/residency_page_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    app:navigationContentDescription="@string/back"
                    app:navigationIcon="@drawable/ic_arrow_back"
                    app:title="" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_heading_top"
                    android:gravity="start"
                    android:text="@string/residency_apps_title"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_heading_summary_top"
                    android:layout_marginBottom="@dimen/page_heading_bottom"
                    android:gravity="start"
                    android:text="@string/residency_apps_subtitle"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

                <LinearLayout
                    android:id="@+id/residency_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.ColorOSBgEnhance.SearchField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/ic_residency_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/residency_search"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:hint="@string/residency_search_hint"
                            android:imeOptions="actionDone"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:maxLines="1"
                            android:minHeight="@dimen/field_min_height"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Option" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/residency_mode_filter_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:labelFor="@id/residency_mode_filter"
                        android:text="@string/residency_filter_mode_hint"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.ColorOSBgEnhance.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                    <com.frostwork.bgenhance.ui.residency.CenteredDropdownTextView
                            style="@style/Widget.ColorOSBgEnhance.DropdownValue"
                            android:id="@+id/residency_mode_filter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/residency_status_filter_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@id/residency_status_filter"
                        android:text="@string/residency_filter_status_hint"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.ColorOSBgEnhance.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                    <com.frostwork.bgenhance.ui.residency.CenteredDropdownTextView
                            style="@style/Widget.ColorOSBgEnhance.DropdownValue"
                            android:id="@+id/residency_status_filter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/residency_result_count"
                android:accessibilityLiveRegion="polite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SectionLabel" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/residency_list_surface"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/residency_app_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="80dp"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/residency_loading_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/residency_loading"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/residency_empty_state"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/residency_empty_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/residency_empty_title"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                        <TextView
                            android:id="@+id/residency_empty_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/residency_empty_summary"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/residency_empty_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/residency_add_app"
                            app:icon="@drawable/ic_residency_add"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </ScrollView>

                <ScrollView
                    android:id="@+id/residency_error_state"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/residency_load_error_title"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/residency_load_error_summary"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/residency_retry"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/residency_retry" />
                    </LinearLayout>
                </ScrollView>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/residency_add_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="@color/brand"
        android:contentDescription="@string/residency_add_app"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_residency_add"
        app:tint="?attr/colorOnPrimary" />
</FrameLayout>
