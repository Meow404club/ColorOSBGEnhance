<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:text="@string/residency_picker_title"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="start"
        android:text="@string/residency_picker_subtitle"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ColorOSBgEnhance.SearchField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:startIconDrawable="@drawable/ic_residency_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/residency_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:hint="@string/residency_search_hint"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="@dimen/field_min_height"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Option" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/residency_show_system_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:minHeight="@dimen/field_min_height"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/residency_show_system_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/residency_show_system_apps"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="2"
                        android:text="@string/residency_show_system_apps_summary"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/residency_show_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/residency_show_system_apps" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView
        android:id="@+id/residency_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SectionLabel"
        android:visibility="gone" />
</LinearLayout>
