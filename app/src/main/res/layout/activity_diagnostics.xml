<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingEnd="@dimen/screen_horizontal">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/diagnostics_title"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/diagnostics_summary"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/diagnostics_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:checkedButton="@id/diagnostics_tab_applications"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/diagnostics_tab_applications"
            style="@style/Widget.ColorOSBgEnhance.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minLines="2"
            android:text="@string/diagnostics_tab_applications" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/diagnostics_tab_behaviors"
            style="@style/Widget.ColorOSBgEnhance.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minLines="2"
            android:text="@string/diagnostics_tab_behaviors" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/diagnostics_tab_hooks"
            style="@style/Widget.ColorOSBgEnhance.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minLines="2"
            android:text="@string/diagnostics_tab_hooks" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/diagnostics_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/diagnostics_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/diagnostics_loading_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/diagnostics_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/diagnostics_loading"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diagnostics_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/diagnostics_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/diagnostics_empty_title"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

            <TextView
                android:id="@+id/diagnostics_empty_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/diagnostics_empty_summary"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diagnostics_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/diagnostics_load_error_title"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/diagnostics_load_error_summary"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagnostics_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/residency_retry" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/diagnostics_verbose_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/verbose_title"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/verbose_summary"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/diagnostics_verbose_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/verbose_title"
            android:showText="false" />
    </LinearLayout>
</LinearLayout>
