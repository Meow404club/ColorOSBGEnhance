<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingEnd="@dimen/screen_horizontal">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="" />

    <TextView
        android:id="@+id/diagnostics_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

    <TextView
        android:id="@+id/diagnostics_detail_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/diagnostics_detail_history_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="@string/diagnostics_history_truncated"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/diagnostics_detail_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/diagnostics_detail_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="6dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/diagnostics_detail_loading_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/diagnostics_loading"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/diagnostics_detail_error_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:accessibilityLiveRegion="polite"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/diagnostics_load_error_title"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/diagnostics_load_error_summary"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/diagnostics_detail_retry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/residency_retry" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
