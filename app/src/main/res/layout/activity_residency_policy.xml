<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal"
            android:paddingEnd="@dimen/screen_horizontal"
            android:paddingBottom="40dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/residency_policy_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <LinearLayout
                android:id="@+id/residency_policy_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/residency_policy_title"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/residency_policy_icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_residency_app" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/residency_policy_app_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                                <TextView
                                    android:id="@+id/residency_policy_package"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="82dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="0dp"
                                android:paddingEnd="12dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/residency_policy_enabled"
                                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/residency_policy_enabled_summary"
                                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/residency_policy_enabled"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/residency_policy_enabled" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/residency_policy_restriction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_notice_warning"
                            android:padding="12dp"
                            android:textColor="@color/banner_warning_text"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_spacing">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/residency_mode_title"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/residency_mode_section_summary"
                            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

                        <LinearLayout
                            android:id="@+id/residency_mode_system_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="top"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/residency_mode_system"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/residency_mode_system" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/residency_mode_system_summary" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/residency_mode_balanced_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="top"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/residency_mode_balanced"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/residency_mode_balanced" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/residency_mode_balanced_summary" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/residency_mode_low_power_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="top"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/residency_mode_low_power"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/residency_mode_low_power" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/residency_mode_low_power_summary" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/residency_mode_active_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="top"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/residency_mode_active"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/residency_mode_active" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/residency_mode_active_summary" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/residency_mode_custom_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="top"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/residency_mode_custom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/residency_mode_custom" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/residency_mode_custom_summary" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <include
                    layout="@layout/view_residency_risk_notices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_spacing"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/residency_custom_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/residency_custom_title"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/residency_custom_summary"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

                    <include
                        layout="@layout/view_residency_kill_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_spacing" />

                    <include
                        layout="@layout/view_residency_freeze_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_spacing" />

                    <include
                        layout="@layout/view_residency_wake_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_spacing" />

                    <include
                        layout="@layout/view_residency_resource_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_spacing" />

                    <include
                        layout="@layout/view_residency_refreeze_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_spacing" />
                </LinearLayout>

                <TextView
                    android:id="@+id/residency_policy_apply_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_spacing"
                    android:background="@color/brand_soft"
                    android:padding="14dp"
                    android:text="@string/residency_apply_without_restart"
                    android:textColor="@color/item_title"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/residency_policy_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="52dp"
                    android:text="@string/residency_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/residency_policy_delete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="52dp"
                    android:text="@string/residency_delete"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    app:icon="@drawable/ic_residency_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/residency_policy_error_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="@color/page_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/residency_load_error_title"
            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/residency_load_error_summary"
            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/residency_policy_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/residency_retry" />
    </LinearLayout>
</FrameLayout>
