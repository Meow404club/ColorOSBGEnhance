<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/residency_freeze_title"
            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.CardTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/residency_freeze_summary"
            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_normal" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_fast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_fast" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_super"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_super" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_preload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_preload" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_custom_timing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_custom_timing" />

        <LinearLayout
            android:id="@+id/residency_freeze_timing_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ColorOSBgEnhance.InputField"
                android:id="@+id/residency_freeze_prepare_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/residency_freeze_prepare_delay">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/residency_freeze_prepare_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ColorOSBgEnhance.InputField"
                android:id="@+id/residency_freeze_execute_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/residency_freeze_execute_delay">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/residency_freeze_execute_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_full_exemption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_full_exemption" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_core_exemption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_core_exemption"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/residency_freeze_lcd_exemption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/residency_freeze_lcd_exemption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
