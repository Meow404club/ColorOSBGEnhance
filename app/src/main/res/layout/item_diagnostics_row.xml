<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:importantForAccessibility="noHideDescendants"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/diagnostics_row_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_residency_app"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/diagnostics_row_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                <TextView
                    android:id="@+id/diagnostics_row_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_residency_badge_neutral"
                    android:gravity="center"
                    android:minHeight="24dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:textColor="@color/chip_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/diagnostics_row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/diagnostics_row_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/item_title"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/diagnostics_row_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/diagnostics_row_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
