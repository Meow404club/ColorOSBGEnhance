<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_heading_top"
        android:gravity="center"
        android:text="@string/residency_apps_title"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_heading_summary_top"
        android:layout_marginBottom="@dimen/page_heading_bottom"
        android:gravity="center"
        android:text="@string/residency_apps_subtitle"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

    <LinearLayout
        android:id="@+id/residency_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ColorOSBgEnhance.SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_residency_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/residency_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:hint="@string/residency_search_hint"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="@dimen/field_min_height"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Option" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/residency_mode_filter_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/residency_mode_filter_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/residency_mode_filter"
                        android:paddingEnd="12dp"
                        android:text="@string/residency_filter_mode_hint"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.ColorOSBgEnhance.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5">

                        <com.frostwork.bgenhance.ui.residency.CenteredDropdownTextView
                            style="@style/Widget.ColorOSBgEnhance.DropdownValue"
                            android:id="@+id/residency_mode_filter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/residency_status_filter_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/residency_status_filter_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/residency_status_filter"
                        android:paddingEnd="12dp"
                        android:text="@string/residency_filter_status_hint"
                        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.ColorOSBgEnhance.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5">

                        <com.frostwork.bgenhance.ui.residency.CenteredDropdownTextView
                            style="@style/Widget.ColorOSBgEnhance.DropdownValue"
                            android:id="@+id/residency_status_filter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView
        android:id="@+id/residency_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SectionLabel"
        android:visibility="gone" />
</LinearLayout>
