<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/residency_picker_state"
    android:accessibilityLiveRegion="polite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="240dp"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/residency_state_progress"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <TextView
        android:id="@+id/residency_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

    <TextView
        android:id="@+id/residency_state_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/residency_state_action"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />
</LinearLayout>
