<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_horizontal" android:paddingEnd="@dimen/screen_horizontal" android:paddingBottom="40dp">
            <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@android:color/transparent" app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/back" app:title="" />
            <TextView android:id="@+id/page_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/page_heading_top" android:gravity="center" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />
            <TextView android:id="@+id/page_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/page_heading_summary_top" android:layout_marginBottom="@dimen/page_heading_bottom" android:gravity="center" android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
            <TextView android:id="@+id/banner_master_disabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_notice_info" android:padding="16dp" android:text="@string/master_disabled_banner" android:textColor="@color/brand" android:textSize="14sp" android:visibility="gone" />
            <TextView android:id="@+id/banner_dry_run" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_notice_warning" android:padding="16dp" android:text="@string/dry_run_banner" android:textColor="@color/banner_warning_text" android:textSize="14sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/card_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
