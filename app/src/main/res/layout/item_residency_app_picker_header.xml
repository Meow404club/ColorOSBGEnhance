<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/residency_picker_title"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.PageTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="@string/residency_picker_subtitle"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ColorOSBgEnhance.SearchField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:startIconDrawable="@drawable/ic_residency_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/residency_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:hint="@string/residency_search_hint"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="@dimen/field_min_height"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Option" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/residency_show_system_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/residency_show_system_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/residency_show_system_apps"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SettingTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/residency_show_system_apps_summary"
                    android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.Summary" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/residency_show_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/residency_show_system_apps" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/residency_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.ColorOSBgEnhance.SectionLabel"
        android:visibility="gone" />
</LinearLayout>
