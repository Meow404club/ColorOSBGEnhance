<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="com.oplus.athena" />
    </queries>

    <application
        android:name=".ModuleApplication"
        android:allowBackup="false"
        android:hasCode="true"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <provider
            android:name=".ModuleBridgeProvider"
            android:authorities="com.frostwork.bgenhance.bridge"
            android:exported="true"
            android:grantUriPermissions="false" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FeatureSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.residency.ResidencyPolicyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.residency.ResidencyPolicyDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.residency.ResidencyImportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.residency.ResidencyAppPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.residency.ResidencyAppsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
